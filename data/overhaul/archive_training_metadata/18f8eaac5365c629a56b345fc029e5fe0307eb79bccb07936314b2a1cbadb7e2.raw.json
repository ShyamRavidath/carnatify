5bb2","crc32":"3fd1239a","sha1":"63d619781601b60cbec3ccb9b9b4217b30be3654","length":"3128.06","height":"0","width":"0"},{"name":"sri rama chandra.png","source":"derivative","format":"PNG","original":"sri rama chandra.mp3","mtime":"1414070785","size":"10404","md5":"3e449f0f037a2a741e87aea6d848c15a","crc32":"15ef00b9","sha1":"81b5020793700b461ca3e0e5e03508406532c391"}],"files_count":8,"item_last_updated":1613699533,"item_size":156563713,"metadata":{"identifier":"SriRamaChandraSatakam-Sanskrit","mediatype":"audio","collection":["opensource_audio","community"],"creator":"Dr.Goli Anjaneyulu","date":"2014-02-12","description":"<p class=\"content\">\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 Srimadajjada AdibhatlaNarayana Das was a linguist with proficiency in as many as eight <br />\nlanguages (including Arabic and Persian), poet, philosopher, playwright,<br />\n composer, dancer, actor and the creator of the unique art form, Harikatha.<br /></p><p>Narayana Das\u00a0 translated into Telugu and set to music RigVeda<br />\n hymns and the only writer-composer who composed a geeta-malika <br />\ncomprising 90 Carnatic ragas. As a writer-composer who composed music in<br />\n all the 72 Carnatic ragas he was next only to Tyagaraja. He also wrote \nKasiSatakam,SuryanarayanaSatakam and SriRamachandraSatakam which is a \ntreatise on Advaitic philosophy. Sri Ramachandrasatakam was translated \ninto Telugu by Sri Rambhatla Lakshminarayana Sastry.</p><p>This year \n2014, Srimadajjada's 150th birth anniversary is celebrated and the \nCentenary celebrations of His visit to Kasi(1914) is also celebrated. <br /></p><p>Listening to Srimadajjada's SriRamachandraSatakam in Sanskrit bestows Peace and Bliss. <br /></p>","language":"san","scanner":"Internet Archive HTML5 Uploader 1.5.1","subject":["Sanskrit SriRamachandraSatakam","Ajjada","Adibhatlanarayanadasu","dr.goli","Sriramachandrasatakam","Ajjada150th birthday"],"title":"Sri RamaChandraSatakam (Sanskrit)","publicdate":"2014-02-12 14:03: