# Raga contamination audit (2026-07-30): the TDMS feature cache is 20MB and is
# regenerable in ~2.5 min by scripts/raga_audit_protocol.py from the committed
# melodia contours. Prereg, protocol.json, results.json and the scripts ARE tracked.
/data/raga_audit/tdms_cache.npz

# Raga duration curve (2026-07-31): the per-window TDMS shards total ~190MB and
# are regenerable by scripts/raga_duration_windows.py from the committed melodia
# contours. Prereg, protocol.json, results.json and the scripts ARE tracked.
/data/raga_duration/tdms_*.npz
/data/raga_duration/preds_fold*.json

# Domain decomposition: per-cell TDMS + stored voiced contours (~40 MB/cell) and
# per-cell prediction rows. Regenerable by scripts/raga_domain_cells.py from the
# committed protocol + the source audio.
/data/raga_domain/cell_*.npz
/data/raga_domain/preds_*.json
/data/raga_domain/tmp/

# Wild raga measurement: Demucs scratch dir only. The 2 MB feature rows in
# data/raga_wild/rows/ ARE committed so the scorer re-runs without rebuilding.
/data/raga_wild/tmp/

# Long-form concerts (2026-08-13): 11 of Deepti's own concert recordings, 851 MB
# of mp3. The freeze record, the labels and the scripts ARE tracked; the audio is
# not. Sources are her .mp4/.MOV in ~/Downloads.
/data/long_concerts/audio/

# Graduated wide-tier raga model (2026-08-13, data/RAGA_TIER_GRADUATION.md).
# The forests are 1.2 GB and are regenerable in ~7 min by
#   venv/bin/python train_raga_v3_tdms.py --min-tracks 10 --out-prefix raga_v4
# The meta and the label encoder ARE tracked, as they are for raga_v3.
/models/raga_v4_tdms_rf.pkl
/models/raga_v4_hist_rf.pkl

# Test pollution: tests/test_raga.py trains a checkpoint into models/.
